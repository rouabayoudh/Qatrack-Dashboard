# Jira OAuth credentials
# Create your OAuth app at https://developer.atlassian.com/console/myapps/
# The callback URL must be added to the OAuth app's allowed callback URLs too.
JIRA_CLIENT_ID=your-jira-client-id
JIRA_CLIENT_SECRET=your-jira-client-secret
JIRA_CALLBACK_URL=http://localhost:3001/jira/callback

# Optional
JWT_SECRET=dev-secret-change-me
PORT=3001
